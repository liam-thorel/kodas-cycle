# Copie ce fichier en `.env.local` et remplis les deux valeurs.
# Sans elles, l'app fonctionne quand meme mais en stockage local uniquement
# (aucune synchro entre ton telephone et celui de ta copine).
#
# Ou les trouver : dashboard Supabase > ton projet > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
